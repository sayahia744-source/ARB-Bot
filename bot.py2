while True:
    try:

        response = requests.get(
            base_url + "/getUpdates",
            params={
                "offset": offset
            },
            timeout=30
        )

        data = response.json()

        if data.get("ok"):

            updates = data.get("result", [])

            for update in updates:

                offset = update["update_id"] + 1

                message = update.get("message")

                if not message:
                    continue

                chat_id = message["chat"]["id"]

                text = message.get("text", "").strip()

                print("پیام:", text)

                if text in answers:

                    reply_text = random.choice(
                        answers[text]
                    )

                else:

                    reply_text = random.choice([
                        "متوجه نشدم",
                        "این یکی رو هنوز یاد نگرفتم",
                        "چی گفتی؟",
                        "نفهمیدم 😂",
                        "این جمله توی حافظه‌م نیست 😭",
                        "یه بار دیگه بگو ببینم چی میگی 👀"
                    ])

                requests.post(
                    base_url + "/sendMessage",
                    json={
                        "chat_id": chat_id,
                        "text": reply_text
                    },
                    timeout=15
                )

        time.sleep(1)

    except Exception as e:

        print("خطا:", e)

        time.sleep(3)
